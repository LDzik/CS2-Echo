<ui:FluentWindow
        x:Class="CS2_Echo.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:CS2_Echo.UI"
        Icon="/Assets/favicon.ico"
        Title="{Binding WindowTitle}" Height="600" Width="1000"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
        Closed="Window_Closed"
    >
    <Grid>


        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/favicon.ico" Width="18" Height="18" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <ui:NavigationView 
            xmlns:pages="clr-namespace:CS2_Echo.UI.Views.Pages"
            Grid.Row="1"
            x:Name="RootNavigation"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            OpenPaneLength="150"
            >
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem 
                    Content="Translations"
                    Icon="{ui:SymbolIcon Translate24}"
                    TargetPageType="{x:Type pages:TranslationsPage}"
                    />
                <ui:NavigationViewItem 
                    Content="Overlay"
                    Icon="{ui:SymbolIcon PictureInPicture24}" 
                    TargetPageType="{x:Type pages:OverlayPage}" Cursor=""
                    />
                <ui:NavigationViewItem 
                    Content="Stats"
                    Icon="{ui:SymbolIcon DatabaseSearch24}"
                    TargetPageType="{x:Type pages:StatsPage}"
                    />
                <ui:NavigationViewItem 
                    Visibility="Hidden"
                    Content="Addons"
                    Icon="{ui:SymbolIcon AppsAddIn24}"
                    TargetPageType="{x:Type pages:StatsPage}"
                    />
                
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem 
                    Content="Info"
                    Icon="{ui:SymbolIcon Info24}"
                    TargetPageType="{x:Type pages:InfoPage}"
                    />
                <ui:NavigationViewItem 
                    Content="Settings"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}"
                    />
            </ui:NavigationView.FooterMenuItems>


        </ui:NavigationView >

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1"/>


        <tray:NotifyIcon x:Name="AppNotifyIcon"
                 TooltipText="CS2 Echo is running"
                 Icon="/Assets/favicon.ico"
                 FocusOnLeftClick="True"
                 LeftClick="AppNotifyIcon_LeftClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu Placement="Mouse" PlacementTarget="{Binding RelativeSource={RelativeSource Self}}" Opened="TrayContextMenu_Opened">
                    
                    <MenuItem Header="Overlay Controls">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="PictureInPicture24"/>
                        </MenuItem.Icon>

                        <MenuItem x:Name="TrayMenuUnlocked" Header="Show Unlocked (Movable)" Click="TrayMenuUnlocked_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="SlideMultiple24" Foreground="#E0E0E0"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem x:Name="TrayMenuLocked" Header="Show Locked (In-Game)" Click="TrayMenuLocked_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="SlideHide24" Foreground="#FFB240"/>
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator/>

                        <MenuItem x:Name="TrayMenuHidden" Header="Hide Overlay" Click="TrayMenuHidden_Click">
                            <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="EyeOff24" Foreground="#AAAAAA"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <MenuItem Header="Open Dashboard" Click="TrayOpen_Click">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="WindowApps24"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <Separator/>

                    <MenuItem Header="Exit CS2 Echo" Click="TrayExit_Click">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Power24" Foreground="#FF4444"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>
