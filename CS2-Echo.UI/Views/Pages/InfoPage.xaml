<Page x:Class="CS2_Echo.UI.Views.Pages.InfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
      Title="InfoPage"
      Foreground="White">

    <Page.CommandBindings>
        <CommandBinding Command="{x:Static markdig:Commands.Hyperlink}" Executed="MarkdownHyperlink_Executed" />
    </Page.CommandBindings>

    <Grid>
        <StackPanel Margin="30" HorizontalAlignment="Left" MinWidth="600" MaxWidth="700">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                <Image Source="/Assets/favicon.ico" Width="64" Height="64" Margin="0,0,20,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CS2 Echo" FontSize="32" FontWeight="Bold" Foreground="#E0E0E0"/>
                    <TextBlock Text="Version 1.3.1" FontSize="14" Foreground="#FFB240" FontWeight="Medium" Margin="0,0,0,5"/>
                    <TextBlock Text="Live, seamless translations for Counter-Strike 2." FontSize="14" Foreground="#AAAAAA"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Application Updates" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>

            <ui:CardControl Margin="0,0,0,30" Padding="15">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="ArrowClockwise24" FontSize="28" Foreground="#FFB240" Margin="0,0,15,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="Software Update" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                            <TextBlock Text="Check for the latest features and bug fixes." Foreground="#AAAAAA" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ui:Button Content="Release Notes" Margin="0,0,10,0" Appearance="Secondary" Icon="{ui:SymbolIcon DocumentText24}" Click="ViewReleaseNotes_Click">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ui:Button Content="Install &amp; Restart" Margin="0,0,10,0" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ApplyUpdateCommand}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="Useful Links" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>

            <ui:CardAction Command="{Binding OpenGitHubCommand}" Margin="0,0,0,10" Padding="15" Background="#0AFFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Code24" FontSize="28" Foreground="#AAAAAA" Margin="0,0,15,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Source Code (GitHub)" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                        <TextBlock Text="View the code, submit pull requests, or star the repository." Foreground="#AAAAAA" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </ui:CardAction>

            <ui:CardAction Command="{Binding ReportBugCommand}" Margin="0,0,0,30" Padding="15" Background="#0AFFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Bug24" FontSize="28" Foreground="#AAAAAA" Margin="0,0,15,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Report an Issue" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                        <TextBlock Text="Found a bug? Let me know so it can be fixed." Foreground="#AAAAAA" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </ui:CardAction>

            <TextBlock Text="Credits &amp; Open Source" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>

            <ui:CardControl Margin="0,0,0,10" Padding="15">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="App Icon Design" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="12" Margin="0,5,0,0">
                            <Run Text="Modified from original work by"/>
                            <Hyperlink NavigateUri="https://icon-icons.com/authors/1510-ooh-seha" RequestNavigate="Hyperlink_RequestNavigate">Ooh Seha</Hyperlink>
                            <Run Text=", licensed under"/>
                            <Hyperlink NavigateUri="https://creativecommons.org/licenses/by/4.0/" RequestNavigate="Hyperlink_RequestNavigate">CC BY 4.0</Hyperlink>.
                        </TextBlock>
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,10" Padding="15">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Third-Party Libraries" FontWeight="SemiBold"/>
                        <TextBlock Text="CS2 Echo is made possible by these incredible open-source projects:" FontSize="12" Foreground="#AAAAAA" Margin="0,5,0,10"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="• WPF UI (lepo.co)" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,3"/>
                            <TextBlock Text="• CommunityToolkit.Mvvm" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,3"/>
                            <TextBlock Text="• Markdig-WPF" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,3"/>
                            <TextBlock Text="• SQLite" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,3"/>
                            <TextBlock Text="• Velopack" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,3"/>
                            <TextBlock Text="• DeepL.net" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,3"/>
                            <TextBlock Text="• Google.GenAI" Foreground="#AAAAAA" FontSize="12"/>

                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>



        </StackPanel>
    </Grid>


</Page>
    
    