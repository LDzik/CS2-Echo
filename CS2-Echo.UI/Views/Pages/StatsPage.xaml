<Page x:Class="CS2_Echo.UI.Views.Pages.StatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="StatsPage"
      Foreground="White"
      xmlns:converters="clr-namespace:CS2_Echo.UI.Converters"
      Loaded="Page_Loaded">

    <Page.Resources>
        <converters:LanguageToFlagConverter x:Key="LangToFlag"/>
    </Page.Resources>
    <Grid Background="#01000000">
        <StackPanel Margin="30" HorizontalAlignment="Left" MinWidth="600" MaxWidth="700">

            <TextBlock Text="Ignore Lists" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <StackPanel Margin="0,0,0,35">

                <ui:CardControl Margin="0,0,0,10" Padding="15">
                    <ui:CardControl.Header>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ignored Players" FontWeight="SemiBold"/>
                            <TextBlock Text="Manually block translations from specific players." FontSize="12" Foreground="#AAAAAA"/>
                        </StackPanel>
                    </ui:CardControl.Header>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" PlaceholderText="Player name..." Text="{Binding ManualPlayerInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" Width="150" ClearButtonEnabled="False"/>
                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Add24}" Appearance="Danger" Command="{Binding AddManualPlayerCommand}"/>
                    </Grid>
                </ui:CardControl>

                <ItemsControl ItemsSource="{Binding IgnoredPlayers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1AFF4444" BorderBrush="#33FF4444" BorderThickness="1" CornerRadius="14" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal" Margin="12,4,4,4">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" Foreground="#FFBDBD" FontWeight="Medium"/>
                                    <ui:Button Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent" Foreground="#FF6B6B" Padding="4" Margin="0" Width="24" Height="24" CornerRadius="12" Command="{Binding DataContext.UnignorePlayerCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" ToolTip="Remove"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="Database Management" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20"/>

            <ui:CardControl Margin="0,0,0,15" Background="#0AFFFFFF">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Grid.Column="0" Symbol="Database24" FontSize="28" Foreground="#AAAAAA" Margin="0,0,15,0"/>
                        <StackPanel>
                            <TextBlock Text="Clear Translation Cache" FontSize="16" FontWeight="SemiBold" Foreground="#FF6B6B"/>
                            <TextBlock Text="{Binding DbSizeText}" Foreground="#AAAAAA" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel>
                    <ui:Button Grid.Column="2" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ClearCacheCommand}"/>
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,25" Background="#0AFFFFFF">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Grid.Column="0" Symbol="People24" FontSize="28" Foreground="#AAAAAA" Margin="0,0,15,0"/>
                        <StackPanel>
                            <TextBlock Text="Wipe Player Data" FontSize="16" FontWeight="SemiBold" Foreground="#FF6B6B"/>
                            <TextBlock Text="Deletes all recorded language profiles." Foreground="#AAAAAA" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel>
                    <ui:Button Grid.Column="2" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ClearPlayerStatsCommand}"/>
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="Player Language Profiling" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>

            <ItemsControl ItemsSource="{Binding PlayerProfiles}" Margin="0,0,0,40">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardExpander Margin="0,0,0,8" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF">
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PlayerName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="16" Height="12" CornerRadius="2" Margin="0,0,6,0">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding PrimaryLanguage, Converter={StaticResource LangToFlag}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding PrimaryLanguage, StringFormat='{}[{0}]'}" Foreground="#E0E0E0" FontWeight="Medium"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalMessages, StringFormat='{}Total Msgs: {0}'}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding LastActive, StringFormat='{}Last Seen: {0}'}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                </Grid>
                            </ui:CardExpander.Header>

                            <ItemsControl ItemsSource="{Binding Languages}" Margin="10,5,0,5">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A000000" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="16" Height="12" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Language, Converter={StaticResource LangToFlag}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="{Binding Language, StringFormat='{}[{0}]'}" Foreground="#E0E0E0" FontWeight="Medium" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding MessageCount, StringFormat='{}x{0}'}" Foreground="#FFB240" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Page>